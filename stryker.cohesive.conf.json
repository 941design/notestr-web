{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Profile: cohesive. Store + reducer + helpers — pure logic with established property tests. Wall time on dev hardware: ~1 min. Use for module-by-module classification dives in the diagnostic loop.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "mutate": [
    "src/store/task-reducer.ts",
    "src/components/pending-invitations-helpers.ts",
    "e2e/fixtures/mls-trace-classify.ts"
  ],
  "reporters": ["html", "json", "progress", "clear-text"],
  "htmlReporter": {
    "fileName": "reports/mutation/cohesive/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/cohesive/mutation.json"
  },
  "tempDirName": ".stryker-tmp/cohesive",
  "timeoutMS": 120000,
  "disableTypeChecks": "src/**/*.{ts,tsx}",
  "checkers": []
}
