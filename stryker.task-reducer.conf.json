{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Focused audit of src/store/task-reducer.ts only — CRDT LWW merge engine.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "mutate": [
    "src/store/task-reducer.ts"
  ],
  "reporters": [
    "html",
    "json",
    "progress",
    "clear-text"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/task-reducer/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/task-reducer/mutation.json"
  },
  "tempDirName": ".stryker-tmp/task-reducer",
  "timeoutMS": 120000,
  "disableTypeChecks": "src/**/*.{ts,tsx}",
  "checkers": [],
  "_ignore_comment": "Stryker copies the project into each sandbox and does NOT honor .gitignore. Exclude large generated/cache dirs — especially the 34k-file pnpm content store, which otherwise bloats every sandbox copy and can trip ENFILE (system file-table overflow) under FD load. None are needed to run the vitest unit suite.",
  "ignorePatterns": [
    "**/.pnpm-store/**",
    "**/.stryker-tmp/**",
    "**/reports/**",
    "**/out/**",
    "**/.next/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/dist/**",
    "**/bug-reports/**",
    "**/e2e/.triage/**",
    "**/.claude/**",
    "**/e2e/**"
  ]
}
