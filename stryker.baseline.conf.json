{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Profile: baseline. Every tested non-React TS module in the project. Used for the across-all-modules baseline pass that captures starting numbers before any test-gap follow-up. Wall time on dev hardware: ~2 min — run once, then phase classification per module via the cohesive / deep profiles.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "mutate": [
    "src/config/base-path.ts",
    "src/config/pwa.ts",
    "src/config/relays.ts",
    "src/lib/nostr.ts",
    "src/store/task-reducer.ts",
    "src/components/pending-invitations-helpers.ts",
    "e2e/fixtures/mls-trace-classify.ts",
    "src/marmot/device-store.ts",
    "src/marmot/event-signer-ndk-adapter.ts",
    "src/marmot/failed-welcomes.ts",
    "src/marmot/forget-device.ts",
    "src/marmot/forgotten-slots.ts",
    "src/marmot/ingest-queue.ts",
    "src/marmot/mls-trace.ts",
    "src/marmot/per-leaf-remove.ts"
  ],
  "reporters": [
    "html",
    "json",
    "progress",
    "clear-text"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/baseline/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/baseline/mutation.json"
  },
  "tempDirName": ".stryker-tmp/baseline",
  "timeoutMS": 180000,
  "disableTypeChecks": "src/**/*.{ts,tsx}",
  "checkers": [],
  "_ignore_comment": "Stryker copies the project into each sandbox and does NOT honor .gitignore. Exclude large generated/cache dirs — especially the 34k-file pnpm content store, which otherwise bloats every sandbox copy and can trip ENFILE (system file-table overflow) under FD load. None are needed to run the vitest unit suite.",
  "ignorePatterns": [
    "**/.pnpm-store/**",
    "**/.stryker-tmp/**",
    "**/reports/**",
    "**/out/**",
    "**/.next/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/dist/**",
    "**/bug-reports/**",
    "**/e2e/.triage/**",
    "**/.claude/**",
    "**/e2e/**"
  ]
}
